---
import {Picture} from 'astro:assets';
import type {ImageMetadata, ImageOutputFormat, ImageQuality} from 'astro';

interface CommonProps {
  alt: string;
  widths: number[];
  sizes: string;
  priority?: boolean;
  class?: string;
  pictureClass?: string;
  formats?: ImageOutputFormat[];
  quality?: ImageQuality;
}

type Props =
  | (CommonProps & {
      src: ImageMetadata;
      width?: number;
      height?: number;
      inferSize?: never;
    })
  | (CommonProps & {
      src: string;
      width: number;
      height: number;
      inferSize?: false;
    })
  | (CommonProps & {
      src: string;
      inferSize: true;
      width?: never;
      height?: never;
    });

const {
  src,
  width,
  height,
  alt,
  widths,
  sizes,
  priority = false,
  class: imgClass,
  pictureClass,
  formats = ['avif', 'webp'],
  quality,
} = Astro.props;

const sharedProps = {
  alt,
  widths,
  sizes,
  formats,
  priority,
  layout: 'none' as const,
  ...(quality !== undefined ? {quality} : {}),
  ...(imgClass !== undefined ? {class: imgClass} : {}),
  ...(pictureClass ? {pictureAttributes: {class: pictureClass}} : {}),
};
---

{typeof src !== 'string' ? (
  <Picture
    src={src}
    {...(width !== undefined ? {width} : {})}
    {...(height !== undefined ? {height} : {})}
    {...sharedProps}
  />
) : width !== undefined && height !== undefined ? (
  <Picture src={src} width={width} height={height} {...sharedProps} />
) : (
  <Picture src={src} inferSize {...sharedProps} />
)}
