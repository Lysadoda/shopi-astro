              <ul class="level3-container flex flex-col">
                {productsMenu.updates.map((upd, idx) => (
                  <li
                    class:list={[
                      'lg:[.level3-container:hover>&]:opacity-50 lg:[.level3-container:hover>&]:hover:opacity-100 relative py-3 first:pt-0 last:pb-0 before:absolute first:before:top-1.5 before:top-3 before:h-[calc(100%+12px)] before:start-1.5 before:w-px ltr:before:-translate-x-1/2 rtl:before:translate-x-1/2 last:before:hidden lg:opacity-0 lg:-translate-y-6 lg:delay-[50ms,0ms] lg:transition-[opacity,translate] lg:duration-300 lg:ease-ease-out-cubic lg:will-change-[opacity,translate] lg:[.level1-item:hover_&]:opacity-100 lg:[.level1-item:focus-within_&]:opacity-100 lg:[.level1-item:hover_&]:translate-y-0 lg:[.level1-item:focus-within_&]:translate-y-0 lg:[.level2-wrapper:hover_&]:delay-0 before:bg-[#1C2C30]',
                      idx === 0 && 'lg:[.level1-item:hover_&]:delay-[400ms,450ms] lg:[.level1-item:focus-within_&]:delay-[400ms,450ms]',
                      idx === 1 && 'lg:[.level1-item:hover_&]:delay-[450ms,500ms] lg:[.level1-item:focus-within_&]:delay-[450ms,500ms]',
                      idx === 2 && 'lg:[.level1-item:hover_&]:delay-[500ms,550ms] lg:[.level1-item:focus-within_&]:delay-[500ms,550ms]',
                    ]}
                  >
                    <a
                      href={upd.href}
                      class="relative flex ps-6 text-pretty before:start-[3px] before:top-1 before:translate-y-1/2 before:absolute before:w-1.5 before:h-1.5 before:rounded-full before:z-20 after:start-0 after:top-1 after:absolute after:w-3 after:h-3 after:rounded-full after:z-10 after:transition-colors after:duration-300 after:delay-0 before:bg-[#f4f4f5] before:ring-black before:ring-2 hover:before:bg-white after:bg-[#1C2C30] hover:after:bg-[#36F4A4]"
                    >
                      {upd.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          </ul>
        </div>
