                  />
                  <source src={productsMenu.editionsCard.mp4} type="video/mp4" />
                </video>
                <p class="flex items-center mb-0.5">
                  {productsMenu.editionsCard.title}
                  <Icon
                    name="icon-arrow"
                    class="w-3.5 h-3.5 shrink-0 opacity-0 rtl:-scale-x-100 lg:[.level3-link:hover_&]:opacity-100 lg:[.level3-link:hover_&]:translate-x-1/2 rtl:lg:[.level3-link:hover_&]:-translate-x-1/2 lg:transition-[opacity,translate] lg:duration-300 lg:will-change-[opacity,translate]"
