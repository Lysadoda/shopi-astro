---
import type {ImageMetadata, ImageOutputFormat} from 'astro';
import {Picture} from 'astro:assets';
import {normalizeVideoSources, type VideoSource} from '../../lib/media';

interface Props {
  image: ImageMetadata | string;
  alt: string;
  sources: string | VideoSource[];
  playLabel?: string;
  isLcp?: boolean;
  controls?: boolean;
  loop?: boolean;
  muted?: boolean;
  aspectClass?: string;
  bgClass?: string;
  mediaClass?: string;
  widths?: number[];
  sizes?: string;
  captionsSrc?: string;
  captionsLang?: string;
  captionsLabel?: string;
  class?: string;
}

const {
  image,
  alt,
  sources,
  playLabel = `Play video: ${alt}`,
  isLcp = false,
  controls = true,
  loop = false,
  muted = false,
  aspectClass = 'aspect-video',
  bgClass = 'bg-black',
  mediaClass = 'object-cover',
  widths = [480, 800, 1280],
  sizes = '(min-width: 64rem) 1024px, 100vw',
  captionsSrc,
  captionsLang = 'en',
  captionsLabel = 'English',
  class: className = '',
} = Astro.props;

const hasPositionUtility = /\b(relative|absolute|fixed|sticky|static)\b/.test(
  className,
);
const normalizedSources = normalizeVideoSources(sources);
const sharedPictureProps = {
  alt,
  formats: ['avif', 'webp'] as ImageOutputFormat[],
  widths,
  sizes,
  priority: isLcp,
  pictureAttributes: {class: 'block size-full'},
  class: ['size-full', mediaClass].filter(Boolean).join(' '),
};
---

<div
  data-video-container
  data-video-facade="true"
  class:list={[
    !hasPositionUtility && 'relative',
    'overflow-hidden',
    aspectClass,
    bgClass,
    className,
  ]}
>
  {typeof image === 'string' ? (
    <Picture src={image} inferSize {...sharedPictureProps} />
  ) : (
    <Picture src={image} {...sharedPictureProps} />
  )}

  <button
    type="button"
    data-video-play
    aria-label={playLabel}
    class="group absolute inset-0 z-10 flex items-center justify-center bg-black/20 transition-colors hover:bg-black/35 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white cursor-pointer"
  >
    <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-black shadow-lg transition-transform group-hover:scale-105">
      <svg
        viewBox="0 0 24 24"
        class="h-6 w-6 translate-x-0.5 fill-current"
        aria-hidden="true"
      >
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </button>

  <video
    class:list={[
      'pointer-events-none absolute inset-0 size-full opacity-0 transition-opacity duration-200',
      mediaClass,
    ]}
    controls={controls}
    muted={muted}
    loop={loop}
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    data-facade-video="true"
    data-sources={JSON.stringify(normalizedSources)}
  >
    {captionsSrc && (
      <track
        kind="captions"
        src={captionsSrc}
        srclang={captionsLang}
        label={captionsLabel}
      />
    )}
  </video>
</div>

<script>
  import '../../scripts/video-loader';
</script>
