---
import type {ImageMetadata, ImageOutputFormat} from 'astro';
import {getImage, Picture} from 'astro:assets';
import {
  normalizeVideoSources,
  type VideoLoadStrategy,
  type VideoSource,
} from '../../lib/media';

interface CommonProps {
  desktopMedia?: string;
  loadStrategy?: VideoLoadStrategy;
  isLcp?: boolean;
  pauseOffscreen?: boolean;
  quality?: number;
  widths?: number[];
  mobileWidths?: number[];
  desktopWidths?: number[];
  sizes?: string;
  alt?: string;
  aspectClass?: string;
  bgClass?: string;
  mediaClass?: string;
  class?: string;
}

interface SingleMediaProps {
  image: ImageMetadata | string;
  sources: string | VideoSource[];
  desktopImage?: never;
  mobileImage?: never;
  desktopSources?: never;
  mobileSources?: never;
}

interface ResponsiveMediaProps {
  desktopImage: ImageMetadata | string;
  mobileImage: ImageMetadata | string;
  desktopSources: string | VideoSource[];
  mobileSources: string | VideoSource[];
  image?: never;
  sources?: never;
}

type Props = CommonProps & (SingleMediaProps | ResponsiveMediaProps);

const props = Astro.props;
const {
  desktopMedia = '(min-width: 64rem)',
  loadStrategy = 'idle',
  isLcp = loadStrategy !== 'visible',
  pauseOffscreen = true,
  quality = 72,
  widths = [480, 768, 1024, 1440],
  mobileWidths = [480, 768, 1024],
  desktopWidths = [1024, 1440, 1920],
  sizes = '100vw',
  alt = '',
  aspectClass = '',
  bgClass = 'bg-black',
  mediaClass = '',
  class: className = 'relative',
} = props;

const isResponsive = props.desktopImage !== undefined;
const isRemote = (src: ImageMetadata | string) => typeof src === 'string';

const responsiveAssets = isResponsive
  ? await (async () => {
      const [mobileAvif, mobileWebp, desktopAvif, desktopWebp] =
        await Promise.all([
          getImage({
            src: props.mobileImage,
            format: 'avif',
            widths: mobileWidths,
            quality,
            ...(isRemote(props.mobileImage) ? {inferSize: true} : {}),
          }),
          getImage({
            src: props.mobileImage,
            format: 'webp',
            widths: mobileWidths,
            quality,
            ...(isRemote(props.mobileImage) ? {inferSize: true} : {}),
          }),
          getImage({
            src: props.desktopImage,
            format: 'avif',
            widths: desktopWidths,
            quality,
            ...(isRemote(props.desktopImage) ? {inferSize: true} : {}),
          }),
          getImage({
            src: props.desktopImage,
            format: 'webp',
            widths: desktopWidths,
            quality,
            ...(isRemote(props.desktopImage) ? {inferSize: true} : {}),
          }),
        ]);
      return {mobileAvif, mobileWebp, desktopAvif, desktopWebp};
    })()
  : null;

const singlePictureProps = !isResponsive
  ? {
      alt,
      formats: ['avif', 'webp'] as ImageOutputFormat[],
      widths,
      sizes,
      quality,
      priority: isLcp,
      pictureAttributes: {class: 'block size-full'},
      class: ['size-full object-cover', mediaClass].filter(Boolean).join(' '),
    }
  : null;

const singleSources = !isResponsive
  ? normalizeVideoSources(props.sources)
  : null;
const mobileVideoSources = isResponsive
  ? normalizeVideoSources(props.mobileSources)
  : null;
const desktopVideoSources = isResponsive
  ? normalizeVideoSources(props.desktopSources)
  : null;
---

<div
  data-video-container
  class:list={['overflow-hidden', aspectClass, bgClass, className]}
  aria-hidden={alt === '' ? 'true' : undefined}
>
  {isResponsive && responsiveAssets ? (
    <picture class="block size-full">
      <source
        media={desktopMedia}
        srcset={responsiveAssets.desktopAvif.srcSet.attribute}
        sizes={sizes}
        width={responsiveAssets.desktopAvif.attributes.width}
        height={responsiveAssets.desktopAvif.attributes.height}
        type="image/avif"
      />
      <source
        media={desktopMedia}
        srcset={responsiveAssets.desktopWebp.srcSet.attribute}
        sizes={sizes}
        width={responsiveAssets.desktopWebp.attributes.width}
        height={responsiveAssets.desktopWebp.attributes.height}
        type="image/webp"
      />
      <source
        srcset={responsiveAssets.mobileAvif.srcSet.attribute}
        sizes={sizes}
        width={responsiveAssets.mobileAvif.attributes.width}
        height={responsiveAssets.mobileAvif.attributes.height}
        type="image/avif"
      />
      <img
        src={responsiveAssets.mobileWebp.src}
        srcset={responsiveAssets.mobileWebp.srcSet.attribute}
        sizes={sizes}
        width={responsiveAssets.mobileWebp.attributes.width}
        height={responsiveAssets.mobileWebp.attributes.height}
        alt={alt}
        loading={isLcp ? 'eager' : 'lazy'}
        decoding={isLcp ? 'sync' : 'async'}
        fetchpriority={isLcp ? 'high' : 'auto'}
        class:list={['size-full object-cover', mediaClass]}
      />
    </picture>
  ) : (
    !isResponsive &&
    singlePictureProps &&
    (isRemote(props.image) ? (
      <Picture src={props.image} inferSize {...singlePictureProps} />
    ) : (
      <Picture src={props.image} {...singlePictureProps} />
    ))
  )}

  <video
    class:list={[
      'pointer-events-none absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-200 motion-reduce:hidden',
      mediaClass,
    ]}
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    aria-hidden="true"
    tabindex="-1"
    data-smart-video
    data-ambient="true"
    data-autoplay="true"
    data-load-strategy={loadStrategy}
    data-pause-offscreen={String(pauseOffscreen)}
    data-desktop-media={isResponsive ? desktopMedia : undefined}
    data-mobile-sources={
      mobileVideoSources ? JSON.stringify(mobileVideoSources) : undefined
    }
    data-desktop-sources={
      desktopVideoSources ? JSON.stringify(desktopVideoSources) : undefined
    }
    data-sources={singleSources ? JSON.stringify(singleSources) : undefined}
  ></video>
</div>

<script>
  import '../../scripts/video-loader';
</script>
