---
import PlaceholderPage from '../../layouts/PlaceholderPage.astro';
import {getPlaceholderStaticPaths, type RouteKey} from '../../data/routes';

export function getStaticPaths() {
  return getPlaceholderStaticPaths('pl');
}

interface Props {
  routeKey: RouteKey;
}

const {routeKey} = Astro.props;
---

<PlaceholderPage routeKey={routeKey} locale="pl" />
